# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Cuentas y créditos (Fase 1 de la hoja de ruta de monetización).
# Ninguna de estas variables cambia el comportamiento actual de la app si se
# dejan sin configurar: todo sigue gratuito y sin cuenta hasta que además se
# active REQUIRE_CREDITS="true".
# ---------------------------------------------------------------------------

# DATABASE_URL: cadena de conexión Postgres (ej. la que entrega Vercel Postgres
# al crear la base desde el panel de Vercel → Storage → Create Database).
# Sin esta variable, todo el sistema de cuentas/créditos queda inactivo.
DATABASE_URL=""

# SESSION_SECRET: cualquier cadena larga y aleatoria (ej. `openssl rand -hex 32`).
# Firma las cookies de sesión — cambiarla desconecta a todos los usuarios.
SESSION_SECRET=""

# GOOGLE_CLIENT_ID: el "Client ID" de un OAuth Client ID de tipo
# "Web application" creado en https://console.cloud.google.com/apis/credentials.
# El mismo valor va también como VITE_GOOGLE_CLIENT_ID (ver más abajo) — no es
# secreto, se expone en el frontend igual que cualquier client ID de OAuth.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# RESEND_API_KEY / EMAIL_FROM: para enviar el enlace mágico por email
# (https://resend.com, tiene plan gratuito). Sin esto, el enlace se imprime
# en los logs del servidor en vez de enviarse — sirve para probar el flujo.
RESEND_API_KEY=""
EMAIL_FROM=""

# ADMIN_SECRET: secreto propio (inventado por vos) para el endpoint manual
# POST /api/auth/admin/grant-credits — puente para cargar créditos a mano
# mientras Mercado Pago/PayPal todavía no están integrados.
ADMIN_SECRET=""

# REQUIRE_CREDITS: el interruptor real. En "false" (o sin definir), Exégesis
# y Diálogo Analítico siguen gratis para todos aunque el resto de estas
# variables ya esté configurado. Pasar a "true" recién cuando se decida
# activar el cobro.
REQUIRE_CREDITS="false"
